@{
    Layout = null;

    // Breadcrumb için route bilgileri (örn: Admin / Deneyimler / DeneyimListesi)
    var area = ViewContext.RouteData.Values["area"]?.ToString();
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var pageTitle = ViewData["Title"]?.ToString() ?? action;

  
}
<!DOCTYPE html>
<html lang="tr">

@await Component.InvokeAsync("_AdminLayoutHeadComponentPartial")

@await RenderSectionAsync("Scripts", required: false)

<body>

    <!-- ==================== SIDEBAR ==================== -->
    @await Component.InvokeAsync("_AdminLayoutSidebarComponentPartial")

    <!-- ==================== MAIN ==================== -->
    <div id="main-content-wrapper">

        <!-- NAVBAR -->
        @await Component.InvokeAsync("_AdminLayoutNavbarComponentPartial")

        <!-- BREADCRUMB / URL -->
        <div class="page-header">
            <h1>@pageTitle</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    @if (!string.IsNullOrEmpty(area))
                    {
                        <li class="breadcrumb-item"><a href="/@area"><i class="bi bi-house-door me-1"></i>@area</a></li>
                    }
                    @if (!string.IsNullOrEmpty(controller))
                    {
                        <li class="breadcrumb-item"><a href="@(string.IsNullOrEmpty(area) ? "" : "/" + area)/@controller">@controller</a></li>
                    }
                    @if (!string.IsNullOrEmpty(action))
                    {
                        <li class="breadcrumb-item active" aria-current="page">@action</li>
                    }
                </ol>
            </nav>
        </div>

        <!-- CONTENT -->
        <main class="main-body-container">
            @RenderBody()
        </main>

        <!-- FOOTER -->
        <footer class="admin-footer">
            <span>© @DateTime.Now.Year Ozan. Portfolio Admin — Tüm hakları saklıdır.</span>
            <span>
                <a href="/" target="_blank">Siteyi Görüntüle</a>
                <span class="mx-2">•</span>
                <span>v1.0</span>
            </span>
        </footer>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function toggleSidebar() {
            document.body.classList.toggle("sidebar-open");
        }
    </script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/delete-confirm.js"></script>

</body>
</html>


