@model Message
@{
    ViewData["Title"] = "Yeni Mesaj";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<link rel="stylesheet" href="~/css/Create-Update.css" asp-append-version="true" />

<div class="row g-4">
    <!-- FORM -->
    <div class="col-12">
        <div class="form-card">
            <form asp-area="Admin" asp-action="CreateMessage" method="post">

                <div class="form-card-header">
                    <div class="form-card-icon"><i class="bi bi-send"></i></div>
                    <div>
                        <h5 class="mb-0 fw-bold">Yeni Mesaj Oluştur</h5>
                        <small class="text-secondary">Gönderici bilgilerini ve mesaj içeriğini doldurun.</small>
                    </div>
                </div>

                <div class="form-card-body">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

                    <div class="row g-4">
                        <!-- Ad Soyad -->
                        <div class="col-lg-4 col-md-12">
                            <label asp-for="NameSurname" class="form-label">Ad Soyad <span class="req">*</span></label>
                            <div class="input-icon-wrap">
                                <i class="bi bi-person"></i>
                                <input asp-for="NameSurname" class="form-control" placeholder="Örn: Ahmet Yılmaz" required />
                            </div>
                            <span asp-validation-for="NameSurname"></span>
                        </div>

                        <!-- Email -->
                        <div class="col-lg-4 col-md-12">
                            <label asp-for="Email" class="form-label">E-posta <span class="req">*</span></label>
                            <div class="input-icon-wrap">
                                <i class="bi bi-envelope"></i>
                                <input asp-for="Email" type="email" class="form-control" placeholder="ornek@mail.com" required />
                            </div>
                            <span asp-validation-for="Email"></span>
                        </div>

                        <!-- Konu -->
                        <div class="col-lg-4 col-md-12">
                            <label asp-for="Subject" class="form-label">Konu <span class="req">*</span></label>
                            <div class="input-icon-wrap">
                                <i class="bi bi-chat-left-text"></i>
                                <input asp-for="Subject" class="form-control" placeholder="Örn: Proje Hakkında" required />
                            </div>
                            <span asp-validation-for="Subject"></span>
                        </div>

                        <!-- Mesaj -->
                        <div class="col-12">
                            <div class="d-flex justify-content-between align-items-end">
                                <label asp-for="MessageDetail" class="form-label">Mesaj <span class="req">*</span></label>
                                <span class="char-counter mb-1"><span id="charCount">0</span> / 2000</span>
                            </div>
                            <textarea asp-for="MessageDetail" id="messageDetail" class="form-control" rows="7" maxlength="2000"
                                      placeholder="Mesajınızı buraya yazın..." required></textarea>
                            <span asp-validation-for="MessageDetail"></span>
                        </div>
                    </div>
                </div>

                <div class="form-card-footer">
                    <a asp-area="Admin" asp-action="MessageList" class="btn btn-soft">
                        <i class="bi bi-arrow-left me-1"></i> Vazgeç
                    </a>
                    <button type="reset" class="btn btn-soft">
                        <i class="bi bi-arrow-counterclockwise me-1"></i> Temizle
                    </button>
                    <button type="submit" class="btn btn-accent">
                        <i class="bi bi-send me-1"></i> Mesajı Gönder
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>