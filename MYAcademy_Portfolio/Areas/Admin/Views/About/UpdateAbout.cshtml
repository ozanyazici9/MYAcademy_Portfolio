@model About

@{
    ViewData["Title"] = "Update About";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<link rel="stylesheet" href="~/css/Create-Update.css" asp-append-version="true" />

<div class="form-card">
    <form asp-area="Admin" asp-action="UpdateAbout" method="post">
        <input type="hidden" asp-for="AboutId" />
        <div class="form-card-header">
            <div class="form-card-icon"><i class="bi bi-briefcase"></i></div>
            <div>
                <h5 class="mb-0 fw-bold">Hakkımda Bölümünü Güncelle</h5>
                <small class="text-secondary">Portfolyonda görünecek hakkımda bilgilerini gir.</small>
            </div>
        </div>

        <div class="form-card-body">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <label asp-for="NameSurname" class="form-label">Ad Soyad <span class="req">*</span></label>
                    <div class="input-icon-wrap">
                        <i class="bi bi-text-left"></i>
                        <input asp-for="NameSurname" class="form-control" placeholder="Örn: Ozan Yazıcı" required />
                    </div>
                    <span asp-validation-for="NameSurname"></span>
                </div>

                <div class="col-lg-4 col-md-6">
                    <label asp-for="JobTitle" class="form-label">Meslek <span class="req">*</span></label>
                    <div class="input-icon-wrap">
                        <i class="bi bi-text-left"></i>
                        <input asp-for="JobTitle" class="form-control" placeholder="Örn: Bilgisayar Mühendisi" required />
                    </div>
                    <span asp-validation-for="JobTitle"></span>
                </div>

                <div class="col-lg-4 col-md-6">
                    <label asp-for="Expert" class="form-label">Uzmanlık Alanı <span class="req">*</span></label>
                    <div class="input-icon-wrap">
                        <i class="bi-patch-check-fill"></i>
                        <input asp-for="Expert" class="form-control" placeholder="Örn: Yazılım Geliştirme" required />
                    </div>
                    <span asp-validation-for="Expert"></span>
                </div>

                <div class="col-lg-4 col-md-6">
                    <label asp-for="Location" class="form-label">Konum <span class="req">*</span></label>
                    <div class="input-icon-wrap">
                        <i class="bi bi-geo-alt"></i>
                        <input asp-for="Location" class="form-control" placeholder="Örn: İstanbul, Türkiye" required />
                    </div>
                    <span asp-validation-for="Location"></span>
                </div>
                <div class="col-lg-4 col-md-6">
                    <label asp-for="Email" class="form-label">Email <span class="req">*</span></label>
                    <div class="input-icon-wrap">
                        <i class="bi bi-envelope"></i>
                        <input asp-for="Email" class="form-control" placeholder="Örn: example@email.com" required />
                    </div>
                    <span asp-validation-for="Email"></span>
                </div>
                <div class="col-lg-4 col-md-6">
                    <label asp-for="OpenToWork" class="form-label">Çalışmaya Açıklık <span class="req">*</span></label>
                    <div class="input-icon-wrap">
                        <i class="bi bi-person-check"></i>
                        <input asp-for="OpenToWork" class="form-control" placeholder="Örn: Yeni projelere ve iş birliklerine açık" required />
                    </div>
                    <span asp-validation-for="OpenToWork"></span>
                </div>
                
                <div class="col-12">
                    <label asp-for="Description" class="form-label">Açıklama <span class="req">*</span></label>
                    <textarea asp-for="Description" class="form-control" rows="5"
                              placeholder="About bölümünde gösterilecek açıklama..." required></textarea>
                    <span asp-validation-for="Description"></span>
                </div>
            </div   
        </div>

        <div class="form-card-footer">
            <a asp-area="Admin" asp-action="Index" class="btn btn-soft">
                <i class="bi bi-arrow-left me-1"></i> Vazgeç
            </a>
            <button type="submit" class="btn btn-accent">
                <i class="bi bi-check2-circle me-1"></i> About Güncelle
            </button>
        </div>
    </form>
</div>