@model List<HeroSection>

@{
    ViewData["Title"] = "Hero Section Listesi";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12">
                <div class="card border-0">
                    <div class="card-body">
                        <div class="card-sub">
                            Hero Sectionlar ile ilgili işlemleri aşağıdaki panelden yapabilirsiniz.
                        </div>
                        <table class="table table mt-3">
                            <thead>
                                <tr>
                                    <th scope="col">#</th>
                                    <th scope="col">Başlık</th>
                                    <th scope="col">Alt Başlık</th>
                                    <th scope="col">Açıklama</th>                          
                                    <th scope="col">ImageUrl</th>                                                        
                                    <th scope="col">Güncelle</th>
                                    <th scope="col">Sil</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.HeroSectionId</td>
                                        <td>@item.Title</td>
                                        <td>@item.SubTitle</td>
                                        <td>@item.Description</td>
                                        <td>@item.ImageUrl</td>
                                        <td><a asp-area="Admin" asp-controller="HeroSection" asp-Action="UpdateHeroSection" asp-route-id="@item.HeroSectionId" class="btn btn-warning">Güncelle</a></td>
                                        <td><a asp-area="Admin" asp-controller="HeroSection" asp-Action="DeleteHeroSection" asp-route-id="@item.HeroSectionId" class="btn btn-danger">Sil</a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <a asp-area="Admin" asp-controller="HeroSection" asp-Action="CreateHeroSection" class="btn btn-primary">Yeni Hero Section Girişi</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>